{
  "name": "fieldlog",
  "version": "0.15.1",
  "description": "Fieldlog — write anywhere, resolve later. Offline-first append-log + SQLite read-model + sync.",
  "repository": { "type": "git", "url": "git+https://github.com/arfoux/fieldlog.git" },
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "bin",
    "demo",
    "example",
    "bench",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md",
    "docs/*.md"
  ],
  "bin": {
    "fieldlog": "bin/fieldlog.js"
  },
  "scripts": {
    "test": "bun test",
    "check:surface": "node scripts/check-published-surface.mjs",
    "build": "tsc -p tsconfig.json",
    "demo": "bun demo/two-node.ts",
    "bench:append": "bun bench/bench-append.ts",
    "bench:query": "bun bench/bench-query.ts",
    "bench:sync": "bun bench/bench-sync.ts"
  },
  "license": "MIT",
  "engines": { "bun": ">=1.0.0" },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "bun-types": "^1.4.1",
    "typescript": "^7.0.2"
  }
}